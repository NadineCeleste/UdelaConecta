{
  "name": "udela-conecta",
  "version": "1.0.0",
  "scripts": {
    "ng": "nx",
    "start": "docker compose -f infra/local/docker-compose.yml --env-file infra/local/.env.local up --build",
    "local:up": "docker compose -f infra/local/docker-compose.yml --env-file infra/local/.env.local up -d --build",
    "local:down": "docker compose -f infra/local/docker-compose.yml --env-file infra/local/.env.local down",
    "local:logs": "docker compose -f infra/local/docker-compose.yml --env-file infra/local/.env.local logs -f",
    "local:ps": "docker compose -f infra/local/docker-compose.yml --env-file infra/local/.env.local ps",
    "vps:up": "docker compose -f infra/vps/docker-compose.prod.yml --env-file infra/vps/.env.vps up -d --build",
    "vps:down": "docker compose -f infra/vps/docker-compose.prod.yml --env-file infra/vps/.env.vps down",
    "vps:logs": "docker compose -f infra/vps/docker-compose.prod.yml --env-file infra/vps/.env.vps logs -f",
    "serve:front": "nx serve frontend",
    "build": "nx build frontend --configuration=production",
    "watch": "nx build frontend --watch --configuration=development",
    "test": "nx run-many -t test -p frontend backend",
    "test:front": "nx test frontend --watch=false --browsers=ChromeHeadless",
    "test:back": "nx test backend"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.5",
    "@angular/cli": "^20.3.5",
    "@angular/compiler-cli": "^20.3.0",
    "@nx/angular": "^24.0.2",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nx": "^24.0.2",
    "typescript": "~5.9.2"
  }
}
