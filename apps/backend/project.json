{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/app",
  "tags": ["scope:backend", "type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "poetry run uvicorn app.main:app --reload --host 0.0.0.0 --port 3000"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "poetry run alembic upgrade head"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "poetry run python -m app.seeds.seed_demo"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "poetry run pytest -v"
      }
    }
  }
}
