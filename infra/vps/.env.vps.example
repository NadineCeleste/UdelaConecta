# Copiar a infra/vps/.env.vps y completar. Nunca versionar .env.vps.
# Subdominio creado en https://www.duckdns.org (sin .duckdns.org, ej. udelaconecta)
DUCKDNS_SUBDOMAIN=CAMBIAR_SUBDOMINIO
# Token de tu cuenta de DuckDNS
DUCKDNS_TOKEN=CAMBIAR_TOKEN_DUCKDNS
# Dominio público (con un dominio real Caddy obtiene HTTPS en Let's Encrypt automáticamente)
DOMAIN=${DUCKDNS_SUBDOMAIN}.duckdns.org
# Puertos del host donde se publica Caddy. Si otro proxy del servidor ya usa 80/443:
# DOMAIN=:80, CADDY_HTTP_PORT=127.0.0.1:8081, CADDY_HTTPS_PORT=127.0.0.1:8082
# y ese proxy reenvía el dominio a 127.0.0.1:8081 (él saca el certificado)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
POSTGRES_USER=udela_prod
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO_AQUI
POSTGRES_DB=udelaconecta_prod
DATABASE_URL=postgresql+asyncpg://udela_prod:CAMBIAR_PASSWORD_SEGURO_AQUI@postgres:5432/udelaconecta_prod
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CAMBIAR_CLAVE_JWT_64_BYTES_ALEATORIA_AQUI
STORAGE_DIR=/data/storage
PUBLIC_STORAGE_BASE_URL=/storage
# Front y API comparten dominio detrás de Caddy; solo hace falta si se consume la API desde otro origen
CORS_ORIGINS=http://localhost
WEB_CONCURRENCY=4
AUTO_SEED=false
# --- n8n: chatbot, orientación de postulación y digest semanal ---
# "n8n" levanta el n8n del compose (red interna). Vacío si el servidor ya tiene su propio n8n.
COMPOSE_PROFILES=n8n
# Clave que cifra las credenciales guardadas en el n8n del compose. Una vez usada, no cambiarla.
# Vacía: deploy.sh genera una aleatoria (o: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
N8N_ENCRYPTION_KEY=
# Secreto compartido backend <-> n8n: es el valor de la credencial Header Auth "Udela-Secret"
# (header X-Udela-Secret) que usan los tres workflows, así que los dos tienen que ser iguales.
# Vacíos: deploy.sh genera uno aleatorio. Con un n8n externo, poner el valor de su credencial
# "Udela-Secret". Nunca dejar un valor de ejemplo: protege los datos que lee /api/automatizacion
N8N_CHAT_SECRET=
N8N_AUTOMATION_SECRET=
# Puerto del editor en 127.0.0.1 del servidor (se entra con: ssh -L 5678:127.0.0.1:5678 usuario@servidor)
N8N_HOST_PORT=5678
# Webhooks y URL de datos del asistente. Con el n8n del compose, todo por la red interna.
# Con un n8n externo: https://N8N_EXTERNO/webhook/udela-chat y .../udela-orientacion, y
# CHAT_DATOS_URL=https://SUBDOMINIO.duckdns.org/api/chat/datos (URL pública del backend)
N8N_CHAT_WEBHOOK_URL=http://n8n:5678/webhook/udela-chat
N8N_ORIENTACION_WEBHOOK_URL=http://n8n:5678/webhook/udela-orientacion
CHAT_DATOS_URL=http://backend:3000/api/chat/datos
N8N_CHAT_TIMEOUT_SEGUNDOS=60
N8N_ORIENTACION_TIMEOUT_SEGUNDOS=30
