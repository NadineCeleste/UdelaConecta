{
	servers {
		# Detrás del Caddy del host (red privada de Docker) se conserva la IP real del visitante
		# en X-Forwarded-For; el backend la usa para el límite de mensajes del asistente
		trusted_proxies static private_ranges
	}
}

# Con DOMAIN=:80 sirve HTTP plano; con un dominio real gestiona HTTPS (Let's Encrypt) automáticamente
{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 6MB
	}

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle /storage/* {
		reverse_proxy backend:3000
	}

	# Front: el build de Angular copiado en /srv por Dockerfile.caddy
	handle {
		root * /srv

		# "route" respeta el orden: los headers se deciden después de reescribir la ruta
		route {
			# Assets con hash en el nombre: caché larga; si no existen, 404
			@assets path *.js *.css *.woff *.woff2 *.ttf *.svg *.png *.jpg *.jpeg *.gif *.ico *.webp
			header @assets Cache-Control "public, max-age=31536000, immutable"

			# SPA: cualquier otra ruta inexistente vuelve a index.html (router de Angular)
			@spa {
				not path *.js *.css *.woff *.woff2 *.ttf *.svg *.png *.jpg *.jpeg *.gif *.ico *.webp
				not file
			}
			rewrite @spa /index.html

			# index.html nunca se cachea para que los deploys se vean al instante
			@index path / /index.html
			header @index Cache-Control "no-cache"

			file_server
		}
	}
}
