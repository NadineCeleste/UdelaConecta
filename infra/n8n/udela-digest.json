      "typeVersion": 1,
      "position": [
        0,
        -220
      ],
      "parameters": {
        "content": "## Digest semanal de oportunidades\nCorre los lunes a las 9:00 (America/Argentina/Buenos_Aires).\n\nGET /api/automatizacion/digests con header X-Udela-Secret. El backend ya calculó la compatibilidad y devuelve solo ofertas libres con más de 60% a las que el estudiante no se postuló.\n\n\nNo envía correos: no requiere SMTP. Los mensajes preparados quedan visibles en la ejecución de n8n, en el nodo \"Reporte interno\".\nNo se rankean personas ni se envían datos sensibles.",
        "height": 290,
        "width": 460,
        "color": 4
      }
    },
    {
      "id": "88a047dd-1064-4581-ab36-77c6103271f5",
      "name": "Obtener digests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "={{ ($env.UDELA_BACKEND_URL || 'http://backend:3000') }}/api/automatizacion/digests",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "AzvZGgZ1GBzJhT8m",
          "name": "Udela-Secret"
        }
      }
    },
    {
      "id": "a767d83f-7fd6-4257-9209-18c3b6960669",
      "name": "Preparar mensajes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const respuesta = $input.first().json || {};\nconst digests = Array.isArray(respuesta.data) ? respuesta.data : [];\nconst salida = [];\nfor (const digest of digests) {\n  const ofertas = Array.isArray(digest.ofertas) ? digest.ofertas : [];\n  if (!ofertas.length) continue;\n  const nombre = String(digest.nombre || '').trim() || String(digest.email || '').split('@')[0];\n  const lineas = ofertas.slice(0, 3).map((oferta) => {\n    const faltantes = Array.isArray(oferta.faltantes) && oferta.faltantes.length\n      ? ` · A capacitar: ${oferta.faltantes.join(', ')}`\n      : '';\n    return `- ${oferta.titulo} (${oferta.coincidencia}% de coincidencia)${faltantes}`;\n  });\n  const texto = [\n    `Hola ${nombre}:`,\n    '',\n    'Estas ofertas pueden interesarte según tu perfil declarado:',\n    ...lineas,\n    '',\n    'Entrá a Udela Conecta para ver el detalle y postularte si querés. La coincidencia es una orientación, no una evaluación ni un ranking.',\n  ].join('\\n');\n  salida.push({\n    json: {\n      email: digest.email,\n      asunto: 'Oportunidades que pueden interesarte en Udela Conecta',\n      texto,\n      ofertas,\n    },\n  });\n}\nreturn salida;"
      }
    },
