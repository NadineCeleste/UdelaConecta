# Solo para desarrollo local: no usar estos valores en producción
POSTGRES_USER=udela
POSTGRES_PASSWORD=udela_local_pass
POSTGRES_DB=udelaconecta
DATABASE_URL=postgresql+asyncpg://udela:udela_local_pass@postgres:5432/udelaconecta
JWT_SECRET_KEY=local-dev-jwt-secret-key-2026-udela-conecta
# Fuera de /app para que el volumen no aparezca dentro del bind-mount del código
STORAGE_DIR=/data/storage
PUBLIC_STORAGE_BASE_URL=http://localhost:3000/storage
AUTO_SEED=true
