      },
      "id": "e8c56a23-3b56-4798-8c69-1ef8e6ed17e3"
    },
    {
      "parameters": {
        "jsCode": "const entrada = $input.first().json;\nconst crudo = entrada.output;\nconst textoOriginal = (typeof crudo === 'string' ? crudo : JSON.stringify(crudo ?? '')).trim();\nconst frasesProhibidas = ['no calificas', 'rechazado', 'no sos apto', 'no cumple', 'no sirve'];\nconst normalizar = (valor) => String(valor)\n  .toLowerCase()\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '');\nconst texto = textoOriginal.replace(/\\s+/g, ' ').trim();\nconst invalido = !texto\n  || texto.length > 600\n  || frasesProhibidas.some((frase) => normalizar(texto).includes(normalizar(frase)));\nreturn [{\n  json: {\n    valido: !invalido,\n    texto,\n    modelo: 'gemini-3.5-flash',\n    a_capacitar: Array.isArray(entrada.a_capacitar) ? entrada.a_capacitar : [],\n  },\n}];"
      },
