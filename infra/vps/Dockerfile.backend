FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false

WORKDIR /app
COPY apps/backend/pyproject.toml apps/backend/poetry.lock ./
RUN pip install "poetry>=2,<3" \
    && poetry install --only main --no-root \
    && pip uninstall -y poetry

COPY apps/backend/alembic.ini ./
COPY apps/backend/alembic ./alembic
COPY apps/backend/app ./app
COPY infra/vps/entrypoint.backend.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/entrypoint.sh \
    && useradd --system --uid 10001 --home /app udela \
    && mkdir -p /data/storage \
    && chown -R udela:udela /data/storage

USER udela
EXPOSE 3000
CMD ["/usr/local/bin/entrypoint.sh"]
