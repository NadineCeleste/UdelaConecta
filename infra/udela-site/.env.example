# Copiar este archivo a .env y completar los valores. No versionar .env.
# n8n es externo a este compose; las URLs de n8n usan la IP del host.

POSTGRES_USER=udela_site
POSTGRES_PASSWORD=change-me
POSTGRES_DB=udelaconecta
# Mantener la misma contraseña que POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://udela_site:change-me@postgres:5432/udelaconecta

JWT_SECRET_KEY=change-me
STORAGE_DIR=/data/storage
PUBLIC_STORAGE_BASE_URL=/storage
CORS_ORIGINS=http://localhost:8083,https://udela.rsdev.dev
AUTO_SEED=false
WEB_CONCURRENCY=2

# n8n existente, fuera de este compose.
N8N_CHAT_WEBHOOK_URL=http://192.168.0.79:5678/webhook/udela-chat
N8N_ORIENTACION_WEBHOOK_URL=http://192.168.0.79:5678/webhook/udela-orientacion
N8N_CHAT_SECRET=change-me
N8N_AUTOMATION_SECRET=change-me

# URL pública que el backend entrega a n8n para consultar los datos del chat.
CHAT_DATOS_URL=http://192.168.0.79:8083/api/chat/datos
CHAT_TOKEN_MINUTOS=5
N8N_CHAT_TIMEOUT_SEGUNDOS=60
N8N_ORIENTACION_TIMEOUT_SEGUNDOS=30
